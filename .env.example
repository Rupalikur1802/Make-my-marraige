# No environment variables are required for the current static foundation.
# Future integrations only: leave these unset until their milestone.
# Never use production credentials for local development or previews.
# APP_ORIGIN=http://localhost:3000
# MONGODB_URI=
# RESEND_API_KEY=
# EMAIL_FROM=
# RATE_LIMIT_SECRET=
# Keep secrets server-side; never prefix them with NEXT_PUBLIC_.

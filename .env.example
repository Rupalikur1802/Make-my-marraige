# Public homepage and login page render without external-service credentials.
# Configure these locally only when connecting an isolated development database.
APP_ORIGIN=http://localhost:3000
MONGODB_URI=
MONGODB_DB=mmm_dev
RATE_LIMIT_SECRET=
# RATE_LIMIT_SECRET must be at least 32 characters; generate a random value locally.
# Non-production/preview databases must be named mmm_dev, mmm_test, or use those prefixes.
# Never reuse production credentials in development or previews.
# Individual invitation delivery is disabled by default; local previews still work.
# Live sending requires a verified sender domain and public HTTPS APP_ORIGIN.
INVITATION_EMAIL_ENABLED=false
RESEND_API_KEY=
# Use a plain verified sender email address, without a display name.
EMAIL_FROM=
# Password-reset delivery remains deferred.
# Never expose credentials through NEXT_PUBLIC_ variables.
